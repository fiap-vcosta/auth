{
  "name": "tech-challenge-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Function CPF → JWT cliente (Tech Challenge FIAP)",
  "main": "src/index.js",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "start": "functions-framework --target=auth --source=src --port=8081",
    "lint": "eslint .",
    "lint:report": "eslint . --format json --output-file eslint-report.json",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --include=src/**/*.js --exclude=src/index.js --reporter=text --reporter=lcov --reporter=json-summary --report-dir=coverage --lines=80 --branches=80 --functions=80 --statements=80 node --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "4.0.0",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "10.1.3",
    "eslint": "9.39.5",
    "eslint-plugin-n": "17.23.1",
    "globals": "16.5.0"
  }
}
