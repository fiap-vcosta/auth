{
  "name": "tech-challenge-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Function CPF → JWT cliente (Tech Challenge FIAP)",
  "main": "src/index.js",
  "engines": {
    "node": "22.23.2"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#presentation/*": "./src/presentation/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env ./node_modules/@google-cloud/functions-framework/build/src/main.js --target=auth --source=src --port=8081",
    "lint": "eslint .",
    "lint:report": "eslint . --format json --output-file eslint-report.json",
    "test": "node --env-file=.env.test --test 'test/**/*.test.js'",
    "test:coverage": "c8 --include=src/**/*.js --exclude=src/index.js --reporter=text --reporter=lcov --reporter=json-summary --report-dir=coverage --lines=80 --branches=80 --functions=80 --statements=80 node --env-file=.env.test --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "cpf-cnpj-validator": "2.1.2",
    "http-problem-details": "0.1.7",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "10.1.3",
    "eslint": "9.39.5",
    "eslint-plugin-n": "17.23.1",
    "globals": "16.5.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
