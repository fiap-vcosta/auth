    {
      "id": "b2000001-auth-0001-4001-8001-000000000011",
      "name": "00-emitir-token-ok",
      "type": "api",
      "parentId": "b2000001-auth-0001-4001-8001-000000000010",
      "deleted": false,
      "data": {
        "type": "http",
        "request": {
          "url": "{{authUrl}}/",
          "method": "POST",
          "headers": [
            {
              "id": 1726150001001,
              "key": "Content-Type",
              "value": "application/json",
              "isEnabled": true,
              "description": ""
            }
          ],
          "queryParams": [],
          "pathVariables": [],
          "body": {
            "contentType": "raw",
            "raw": "{\n  \"documento\": \"{{documento}}\"\n}",
            "rawContentType": "application/json"
          },
          "contentType": "raw"
        },
        "auth": {
          "type": "inherit"
        },
        "scripts": {
          "preRequest": "if (!rq.environment.get(\"authUrl\")) {\n  rq.environment.set(\"authUrl\", \"http://localhost:8081\");\n}\nif (!rq.environment.get(\"documento\")) {\n  rq.environment.set(\"documento\", \"92561324354\");\n}",
          "postResponse": "rq.test(\"Emite JWT com 200\", function () {\n  rq.expect((rq.response.code != null ? rq.response.code : rq.response.status)).to.equal(200);\n});\nvar jsonData = rq.response.json();\nrq.test(\"Resposta tem token\", function () {\n  rq.expect(jsonData).to.have.property(\"token\");\n  rq.expect(jsonData.token).to.be.a(\"string\").and.not.empty;\n});\nrq.environment.set(\"tokenCliente\", jsonData.token);"
        }
      },
      "rank": "a0"
    },
