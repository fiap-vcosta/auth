# API local (repo api: docker compose --profile app → :8080)
# No Compose deste repo, o default é http://host.docker.internal:8080
API_BASE_URL=http://localhost:8080

# JWT cliente (mesmo material que a api/.env.example — Function assina; API valida)
JWT_CLIENTE_KEY=local-jwt-cliente-key-change-me-32chars-min
JWT_CLIENTE_ISSUER=tech-challenge-cliente
JWT_CLIENTE_AUDIENCE=tech-challenge-cliente

# Service auth (Function → API; header X-Service-Key)
SERVICE_AUTH_KEY=local-service-auth-key-change-me
